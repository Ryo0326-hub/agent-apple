# Copy to .env.dev for local fixture/replay work and run chmod 600 .env.dev.
# The placeholder credentials are intentionally sufficient for broker-isolated replay.
THETATRAP_ENVIRONMENT=development
THETATRAP_EXPECTED_ACCOUNT_ID=replace_with_dev_paper_account_uuid
THETATRAP_DATABASE_PATH=data/dev/thetatrap.sqlite3
THETATRAP_READ_ONLY=true
THETATRAP_EXECUTION_ENABLED=false
THETATRAP_MCP_EXPECTED_SCHEMA_HASH=0d08e617a03b38fe236951ab7bafa6ae07195c1c3efca1db5fae61bdecc7db72
THETATRAP_LOG_LEVEL=INFO
THETATRAP_WORKER_INTERVAL_SECONDS=60

ALPACA_API_KEY=replace_with_dev_paper_api_key
ALPACA_SECRET_KEY=replace_with_dev_paper_secret_key
ALPACA_PAPER_TRADE=true
ALPACA_TOOLSETS=account,trading,assets,stock-data,options-data,news
# Fail-closed Alpaca Basic data profile. Do not change without a reviewed profile.
ALPACA_STOCK_FEED=iex
ALPACA_OPTION_FEED=indicative

FEATHERLESS_API_KEY=replace_with_featherless_api_key
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_PRIMARY_MODEL=Qwen/Qwen3-Coder-Next
FEATHERLESS_FALLBACK_MODEL=Qwen/Qwen3-32B
TZ=America/New_York
